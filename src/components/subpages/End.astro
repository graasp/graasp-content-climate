---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import graaspLogo from '../../images/graasp.svg';

import { Image } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="container-fluid spaced-container"
  id="contact"
  style={{ backgroundColor: '#cbe6ef' }}
>
  <div
    class="container flexbox flex-row align-items-center justify-content-center gap-5"
  >
    <Image class="logo" src={graaspLogo} alt="Graasp Climate logo" />

    <div class="flexbox">
      <h2 class="text-left mb-4" style={{ color: 'black' }}>
        {t('Contact us')}
      </h2>
      <p class="text-left">{t('CONTACT_FORM_TEXT_1')}</p>
      <p class="text-left" set:html={t('CONTACT_FORM_TEXT_2')} />
      <a class="text-left mt-3" href="mailto:climate@graasp.org">
        <button class="btn btn-light mb-4 py-3" type="submit">
          {t('SEND_EMAIL_BUTTON')}
        </button></a
      >
    </div>
  </div>
</div>
