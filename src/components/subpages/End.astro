---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="container-fluid spaced-container"
  id="contact"
  style={{ backgroundColor: '#cbe6ef' }}
>
  <div class="container">
    <div class="flexbox">
      <h2 class="text-center mb-4" style={{ color: 'black' }}>
        {t('Contact us')}
      </h2>
      <p class="text-center">{t('CONTACT_FORM_TEXT_1')}</p>
      <p class="text-center">{t('CONTACT_FORM_TEXT_2')}</p>
      <a class="text-center mt-3" href="mailto:climate@graasp.org">
        <button class="btn btn-light mb-4 py-3" type="submit">
          {t('SEND_EMAIL_BUTTON')}
        </button></a
      >
    </div>
  </div>
</div>
