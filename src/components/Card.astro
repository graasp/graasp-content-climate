---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  iconSrc: string;
}
const { title, iconSrc } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="col-12 col-md-6 col-lg-4 gx-4 gy-4">
  <div class="card p-3" style={{ background: '#eaffe2', borderRadius: '20px' }}>
    <div class="d-flex flex-row align-items-center">
      <div class="col-2">
        <img alt={`${title} link`} src={iconSrc} width={34} />
      </div>
      <div class="col-10">{title}</div>
    </div>
  </div>
</div>
